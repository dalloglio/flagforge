{
  "name": "flagforge",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/infrastructure/postgres/migrate.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude test/postgres.integration.test.ts",
    "test:postgres": "vitest run test/postgres.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:validate": "redocly lint docs/api/openapi.yaml",
    "openapi:preview": "redocly build-docs docs/api/openapi.yaml --output /tmp/flagforge-openapi.html --title \"FlagForge API\"",
    "gitops:aws:validate": "helm lint charts/flagforge-api --values infra/aws/gitops/dev/us-east-1/values-aws-dev.yaml && helm template flagforge-api charts/flagforge-api --namespace flagforge --values infra/aws/gitops/dev/us-east-1/values-aws-dev.yaml > /tmp/flagforge-aws-gitops-rendered.yaml",
    "openspec:validate": "openspec validate --all --strict",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run openapi:validate && npm run openspec:validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-express": "^0.68.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.3.1",
    "@redocly/cli": "^2.32.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
